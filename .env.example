# Device for the model: cuda, mps or cpu. cpu runs in full precision (float32); cuda and mps in float16.
HELM_DEVICE=cpu

# Where the trained weights (adapter/ and head.pt) come from. HELM_WEIGHTS_DIR wins when both are set.
# Hugging Face Hub model repo holding adapter/ and head.pt, and the branch/tag/commit to use.
# This repo is private: HF_TOKEN below must have read access to it.
HELM_HF_REPO=YashDT/aethis-helm-weights
HELM_HF_REVISION=main
# Or a local directory containing adapter/ and head.pt (skips the Hub):
# HELM_WEIGHTS_DIR=/path/to/checkpoint

# Hugging Face token with read access to HELM_HF_REPO (write access for scripts/upload_weights.py).
# Required for the private weights repo unless you have run `hf auth login` on this machine.
HF_TOKEN=

# Base model. Must be the one the adapter was trained on.
HELM_BACKBONE=Qwen/Qwen2.5-1.5B-Instruct

# Download cache for the backbone and weights. Leave commented to use the default
# (~/.cache/huggingface locally, /models/hf in the Docker image).
# HF_HOME=/path/to/cache

# Server bind address and port. Use 0.0.0.0 to accept connections from other machines.
HELM_HOST=127.0.0.1
HELM_PORT=8000
HELM_LOG_LEVEL=INFO
