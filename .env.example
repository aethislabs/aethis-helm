# Device for the model: cuda, mps or cpu. cpu runs in full precision (float32); cuda and mps in float16.
HELM_DEVICE=cpu

# Where the trained weights (adapter/ and head.pt) come from. HELM_WEIGHTS_DIR wins when both are set.
# Local directory containing adapter/ and head.pt:
HELM_WEIGHTS_DIR=
# Hugging Face Hub model repo holding adapter/ and head.pt, and the branch/tag/commit to use:
HELM_HF_REPO=
HELM_HF_REVISION=main

# Base model. Must be the one the adapter was trained on.
HELM_BACKBONE=Qwen/Qwen2.5-1.5B-Instruct

# Hugging Face token: only needed if HELM_HF_REPO is private (also used by scripts/upload_weights.py).
HF_TOKEN=
# Download cache for the backbone and weights (the Docker image uses /models/hf).
HF_HOME=

# Server bind address and port. Use 0.0.0.0 to accept connections from other machines.
HELM_HOST=127.0.0.1
HELM_PORT=8000
HELM_LOG_LEVEL=INFO
